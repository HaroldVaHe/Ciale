# Copia este archivo a .env.local y completa los valores.
# Nunca commitees .env.local — ya está cubierto por .gitignore.

# Supabase (Fase 2) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fase 3 — correo único con acceso a /admin (fail-closed si se deja vacío)
ADMIN_EMAIL=

# Opcional: verificación de Google Search Console vía meta tag
# (el método recomendado y documentado es DNS; esto es solo alternativa)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
